# Cloudflare Pages: files under /assets carry a version (?v=…), so they can be cached for a long time.
/assets/*
  Cache-Control: public, max-age=31536000
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
/admin/*
  X-Robots-Tag: noindex
/exempel/*
  X-Robots-Tag: noindex
/exempel/*/img/*
  Cache-Control: public, max-age=2592000
# the example sites' shared stylesheet and script carry a version (?v=…); fonts never change
/exempel/delat/*
  Cache-Control: public, max-age=31536000
/exempel/*/assets/*
  Cache-Control: public, max-age=31536000
/exempel/typsnitt/*
  Cache-Control: public, max-age=2592000
